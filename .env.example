# ─── Site ──────────────────────────────────────────────────────────────
# Public URL used for canonical links, sitemap, Stripe redirects and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public contact address shown on the site (PROVISIONAL until Sarah confirms).
NEXT_PUBLIC_CONTACT_EMAIL=hello@harlowbrookflowers.com

# ─── Database ──────────────────────────────────────────────────────────
# Local: a SQLite file. Production: a hosted libSQL/Turso URL + token.
DATABASE_URL=file:./data/harlow-brook.db
DATABASE_AUTH_TOKEN=

# ─── Admin ─────────────────────────────────────────────────────────────
# Used by `npm run db:seed` to create the first admin login (min 12 characters).
ADMIN_EMAIL=sarah@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_NAME=Sarah

# ─── Payments (Stripe Checkout) ────────────────────────────────────────
# Leave blank to run in DEMO mode: no payment is taken and orders are clearly marked as demos.
# Use test keys (sk_test_…) first. Live keys (sk_live_…) are refused unless ALLOW_LIVE_PAYMENTS=true
# AND "Catalog approved" is switched on in /admin/settings.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_LIVE_PAYMENTS=false

# ─── Email (optional) ──────────────────────────────────────────────────
# Without a key, emails are recorded in the admin outbox instead of being sent.
RESEND_API_KEY=
EMAIL_FROM="Harlow Brook Flowers <orders@harlowbrookflowers.com>"

# ─── Image uploads in production (optional) ────────────────────────────
# Without a token, admin photo uploads are saved to /public/uploads (local development only).
BLOB_READ_WRITE_TOKEN=

# ─── Analytics & Search Console (optional) ─────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# ─── Contact form spam protection (optional) ───────────────────────────
# Cloudflare Turnstile. The form also uses a honeypot, a timing check and rate limiting.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
